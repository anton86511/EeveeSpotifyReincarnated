+            }
+            if player.mode == .hq4 && !player.hasBundledModel {
+                Button("instrumental_import".localized) { choosingModel = true }
+                    .disabled(player.enabled || player.busy)
+            }
+        }
+        .eeveeSettingsStyle()
+        .fileImporter(isPresented: $choosingModel, allowedContentTypes: [
+            UTType(importedAs: "com.apple.coreml.mlpackage", conformingTo: .package), .package, .folder
+        ]) { result in
+            if case let .success(url) = result { player.importModel(url) }
+        }
+    }
+}
+
+enum InstrumentalMode: String, CaseIterable {
+    case immediate, hq4
+
+    var title: String { self == .immediate ? "instrumental_mode_immediate" : "instrumental_mode_hq4" }
+    var help: String { self == .immediate ? "instrumental_immediate_help" : "instrumental_buffer_help" }
+}
+
+@available(iOS 16.0, *)
+func restoreLiveInstrumentalAtLaunch() {
+    LiveInstrumentalSettings.shared.restore()
+}
+
+@available(iOS 16.0, *)
+final class LiveInstrumentalSettings: ObservableObject {
+    // Keep the playback effect active when the user closes settings.
+    static let shared = LiveInstrumentalSettings()
+    private let worker = LiveInstrumentalWorker()
+    private let defaults = UserDefaults.standard
+    private static let modeKey = "eevee.liveInstrumental.mode"
+    private let enabledKey = "eevee.liveInstrumental.enabled"
+    @Published var mode: InstrumentalMode {
+        didSet {
+            message = nil
+            defaults.set(mode.rawValue, forKey: Self.modeKey)
+        }
+    }
+    @Published private(set) var enabled = false
+    @Published private(set) var busy = false
+    @Published private var message: String?
+
+    private init() {
+        mode = InstrumentalMode(rawValue: UserDefaults.standard.string(forKey: Self.modeKey) ?? "") ?? .immediate
+    }
+
+    func restore() {
+        guard defaults.bool(forKey: enabledKey), EeveeInstrumentalAvailable() else { return }
+        setEnabled(true)
+    }
+    var hasBundledModel: Bool { bundledModel != nil }
+
+    private var bundledModel: URL? {
+        Bundle.main.url(forResource: "InstHQ4", withExtension: "mlmodelc")
+    }
+
+    private var storedModel: URL {
+        FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0]
+            .appendingPathComponent("LiveInstrumental", isDirectory: true)
+            .appendingPathComponent("InstHQ4.mlmodelc", isDirectory: true)
+    }
+
+    var modelURL: URL? {
+        bundledModel ?? (FileManager.default.fileExists(atPath: storedModel.path) ? storedModel : nil)
+    }
+
+    var canToggle: Bool {
+        !busy && (enabled || mode == .immediate || modelURL != nil)
+    }
+
+    var status: String {
+        if let message = message { return message }
+        if busy { return "instrumental_loading" }
+        if mode == .hq4 && modelURL == nil { return "instrumental_needs_model" }
+        if !enabled { return "instrumental_off" }
+        switch EeveeInstrumentalStatus() {
+        case 2: return "instrumental_playing"
+        case 3: return "instrumental_dry"
+        case 4: return "instrumental_unsupported_audio"
+        case 5: return "instrumental_immediate_playing"
+        default: return mode == .immediate ? "instrumental_immediate_waiting" : "instrumental_waiting"
+        }
+    }
+
+    func setEnabled(_ enable: Bool) {
+        guard canToggle, enable != enabled else { return }
+        message = nil
+        if !enable {
+            worker.stop()
+            enabled = false
+            defaults.set(false, forKey: enabledKey)
+            return
+        }
+        if mode == .immediate {
+            enabled = EeveeInstrumentalEnableImmediate()
+            defaults.set(enabled, forKey: enabledKey)
+            if !enabled { message = "instrumental_unsupported_audio" }
+            return
+        }
+        guard let modelURL = modelURL else { return }
+        busy = true
+        worker.start(url: modelURL) { started in
+            DispatchQueue.main.async {
+                self.busy = false
+                self.enabled = started
+                self.defaults.set(started, forKey: self.enabledKey)
+                if !started { self.message = "instrumental_model_error" }
+            }
+        }
+    }
+
+    func importModel(_ url: URL) {
+        guard url.pathExtension.lowercased() == "mlpackage" else {
+            message = "instrumental_needs_model"
+            return
+        }
+        message = nil
+        busy = true
+        let destination = storedModel
+        DispatchQueue.global(qos: .userInitiated).async {
+            let access = url.startAccessingSecurityScopedResource()
+            defer { if access { url.stopAccessingSecurityScopedResource() } }
+            do {
+                let compiled = try MLModel.compileModel(at: url)
+                let files = FileManager.default
+                defer { try? files.removeItem(at: compiled) }
+                _ = try HQ4InstrumentalModel(url: compiled)
+                try files.createDirectory(at: destination.deletingLastPathComponent(), withIntermediateDirectories: true)
+                if files.fileExists(atPath: destination.path) {
+                    _ = try files.replaceItemAt(destination, withItemAt: compiled)
+                } else {
+                    try files.moveItem(at: compiled, to: destination)
+                }
+                DispatchQueue.main.async { self.busy = false }
+            } catch {
+                DispatchQueue.main.async {
+                    self.busy = false
+                    self.message = "instrumental_model_error"
+                }
+            }
+        }
+    }
+}
diff --git a/Sources/EeveeSpotify/Karaoke/LiveInstrumentalWorker.swift b/Sources/EeveeSpotify/Karaoke/LiveInstrumentalWorker.swift
new file mode 100644
index 0000000..f4572d7
--- /dev/null
+++ b/Sources/EeveeSpotify/Karaoke/LiveInstrumentalWorker.swift
@@ -0,0 +1,231 @@
+import EeveeSpotifyC
+import Foundation
+import UIKit
+
+@available(iOS 16.0, *)
+final class LiveInstrumentalWorker {
+    private let queue = DispatchQueue(label: "com.eevee.instrumental", qos: .userInitiated)
+    private var timer: DispatchSourceTimer?
+    private var model: HQ4InstrumentalModel?
+    private var stream: HQ4Stream?
+    private var generation: UInt32 = 0
+    private let activityLock = NSLock()
+    private var foregroundEpoch: UInt?
+    private var activityEpoch: UInt = 0
+    private var activityObservers: [NSObjectProtocol] = []
+
+    func start(url: URL, completion: @escaping (Bool) -> Void) {
+        observeAppActivity()
+        queue.async {
+            do {
+                let model = try HQ4InstrumentalModel(url: url)
+                self.model = model
+                self.generation = 0
+                if !EeveeInstrumentalEnable() {
+                    self.model = nil
+                    completion(false)
+                    return
+                }
+                let timer = DispatchSource.makeTimerSource(queue: self.queue)
+                timer.schedule(deadline: .now(), repeating: .milliseconds(35), leeway: .milliseconds(5))
+                timer.setEventHandler { [weak self] in
+                    guard let self = self else { return }
+                    autoreleasepool { self.process() }
+                }
+                self.timer = timer
+                timer.resume()
+                completion(true)
+            } catch {
+                self.stopOnQueue()
+                completion(false)
+            }
+        }
+    }
+
+    private func observeAppActivity() {
+        guard activityObservers.isEmpty else { return }
+        let center = NotificationCenter.default
+        activityObservers = [
+            center.addObserver(forName: UIApplication.willResignActiveNotification,
+                               object: nil, queue: .main) { [weak self] _ in
+                self?.setForeground(false)
+            },
+            center.addObserver(forName: UIApplication.didEnterBackgroundNotification,
+                               object: nil, queue: .main) { [weak self] _ in
+                self?.setForeground(false)
+            },
+            center.addObserver(forName: UIApplication.didBecomeActiveNotification,
+                               object: nil, queue: .main) { [weak self] _ in
+                self?.setForeground(true)
+            }
+        ]
+        setForeground(UIApplication.shared.applicationState == .active)
+    }
+
+    deinit {
+        for observer in activityObservers { NotificationCenter.default.removeObserver(observer) }
+    }
+
+    private func setForeground(_ active: Bool) {
+        activityLock.lock()
+        activityEpoch &+= 1
+        foregroundEpoch = active ? activityEpoch : nil
+        activityLock.unlock()
+        EeveeInstrumentalSetAppActive(active)
+    }
+
+    private func currentGPUEpoch() -> UInt? {
+        activityLock.lock()
+        defer { activityLock.unlock() }
+        return foregroundEpoch
+    }
+
+    func stop() {
+        EeveeInstrumentalDisable()
+        queue.async { self.stopOnQueue() }
+    }
+
+    private func stopOnQueue() {
+        timer?.cancel()
+        timer = nil
+        stream = nil
+        model = nil
+    }
+
+    private func process() {
+        let source = EeveeInstrumentalCurrentStream()
+        guard source.generation != 0, let model = model else { return }
+        if source.generation != generation {
+            stream = HQ4Stream(sampleRate: Int(source.sampleRate))
+            generation = source.generation
+        }
+        let thermal = ProcessInfo.processInfo.thermalState
+        stream?.process(generation: generation, useModel: thermal != .serious && thermal != .critical) { audio in
+            return try? model.separate(audio, gpuEpoch: self.currentGPUEpoch)
+        }
+    }
+}
+
+@available(iOS 16.0, *)
+private final class HQ4Stream {
+    private let frameCount: Int
+    private let hop: Int
+    private let toModel: HQ4Resampler
+    private let fromModel: HQ4Resampler
+    private var input: [EeveeStereoFrame]
+    private var count = 0
+    private var position: UInt64 = 0
+    private var pending: [EeveeStereoFrame] = []
+    private var output: [EeveeStereoFrame] = []
+    private var written = 0
+
+    init(sampleRate: Int) {
+        let modelRate = HQ4InstrumentalModel.sampleRate
+        frameCount = (HQ4InstrumentalModel.window * sampleRate + modelRate - 1) / modelRate
+        hop = HQ4InstrumentalModel.hop * sampleRate / modelRate
+        toModel = HQ4Resampler(from: sampleRate, to: modelRate)
+        fromModel = HQ4Resampler(from: modelRate, to: sampleRate)
+        input = Array(repeating: EeveeStereoFrame(left: 0, right: 0), count: frameCount)
+    }
+
+    func process(generation: UInt32, useModel: Bool, separate: ([[Float]]) -> [[Float]]?) {
+        if written < output.count {
+            flush(generation)
+            return
+        }
+
+        let appended = input.withUnsafeMutableBufferPointer { buffer in
+            EeveeInstrumentalRead(generation, buffer.baseAddress! + count, UInt32(frameCount - count))
+        }
+        count += Int(appended)
+        guard count == frameCount else { return }
+
+        let stems: [[Float]]?
+        if useModel {
+            let frames = toModel.convert(input, count: HQ4InstrumentalModel.window)
+            stems = separate([frames.map(\.left), frames.map(\.right)])
+        } else {
+            stems = nil
+        }
+        if let stems {
+            let wet = zip(stems[0], stems[1]).map { EeveeStereoFrame(left: $0.0, right: $0.1) }
+            output = fromModel.convert(wet, count: frameCount)
+        } else {
+            output = input
+        }
+
+        let overlap = frameCount - hop
+        for i in pending.indices {
+            let mix = Float(i + 1) / Float(overlap + 1)
+            output[i].left = pending[i].left * (1 - mix) + output[i].left * mix
+            output[i].right = pending[i].right * (1 - mix) + output[i].right * mix
+        }
+        if stems != nil {
+            pending = Array(output[hop...])
+            output.removeLast(overlap)
+        } else {
+            // Leave this range empty so the render thread uses center attenuation.
+            // Keep the overlapping original frames for a clean return to the model.
+            pending = Array(input[hop...])
+            output.removeAll(keepingCapacity: true)
+        }
+        input.replaceSubrange(0..<overlap, with: Array(input[hop...]))
+        count = overlap
+        written = 0
+        if stems != nil { flush(generation) }
+        else { position += UInt64(hop) }
+    }
+
+    private func flush(_ generation: UInt32) {
+        let sent = output.withUnsafeBufferPointer { buffer in
+            EeveeInstrumentalWrite(generation, buffer.baseAddress! + written,
+                                    UInt32(output.count - written), position)
+        }
+        position += UInt64(sent)
+        written += Int(sent)
+    }
+}
+
+// The two supported rates have a repeating rational phase. A windowed sinc
+// filter avoids sending aliased high frequencies to the model at 48 kHz.
+private struct HQ4Resampler {
+    private let numerator: Int
+    private let denominator: Int
+    private let kernels: [[Float]]
+    private let radius = 16
+
+    init(from: Int, to: Int) {
+        let unit = from == to ? from : 300
+        numerator = from / unit
+        denominator = to / unit
+        let radius = 16
+        let cutoff = min(1, Double(to) / Double(from))
+        kernels = from == to ? [] : (0..<(to / unit)).map { phase in
+            let weights = (-radius + 1...radius).map { tap -> Double in
+                let distance = Double(tap) - Double(phase) / Double(to / unit)
+                let argument = Double.pi * distance * cutoff
+                let sinc = argument == 0 ? 1 : sin(argument) / argument
+                return abs(distance) < Double(radius)
+                    ? sinc * (0.5 + 0.5 * cos(Double.pi * distance / Double(radius))) : 0
+            }
+            let sum = weights.reduce(0, +)
+            return weights.map { Float($0 / sum) }
+        }
+    }
+
+    func convert(_ input: [EeveeStereoFrame], count: Int) -> [EeveeStereoFrame] {
+        guard !kernels.isEmpty else { return input }
+        return (0..<count).map { index in
+            let phase = index * numerator
+            let start = phase / denominator - radius + 1
+            let kernel = kernels[phase % denominator]
+            var frame = EeveeStereoFrame(left: 0, right: 0)
+            for tap in kernel.indices {
+                let sample = input[min(input.count - 1, max(0, start + tap))]
+                frame.left += sample.left * kernel[tap]
+                frame.right += sample.right * kernel[tap]
+            }
+            return frame
+        }
+    }
+}
