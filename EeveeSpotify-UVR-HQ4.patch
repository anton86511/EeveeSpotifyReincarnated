diff --git a/Tests/LiveInstrumentalStream.c b/Tests/LiveInstrumentalStream.c
new file mode 100644
index 0000000..22151c4
--- /dev/null
+++ b/Tests/LiveInstrumentalStream.c
@@ -0,0 +1,72 @@
+#include <assert.h>
+#include <stdio.h>
+#include "../Sources/EeveeSpotifyC/LiveInstrumental.m"
+
+enum { Frames = 256 };
+static float samples[Frames * 2];
+static EeveeStereoFrame incoming[Frames], instrumental[Frames];
+static const int unit;
+static AudioStreamBasicDescription format = {
+    .mSampleRate = 48000, .mFormatID = kAudioFormatLinearPCM,
+    .mFormatFlags = kAudioFormatFlagIsFloat | kAudioFormatFlagIsPacked,
+    .mBytesPerFrame = 8, .mChannelsPerFrame = 2, .mBitsPerChannel = 32,
+};
+static AudioBufferList buffer = {
+    .mNumberBuffers = 1, .mBuffers = {{ 2, sizeof(samples), samples }},
+};
+
+static void play(float value) {
+    for (unsigned i = 0; i < Frames * 2; ++i) samples[i] = value;
+    render(&unit, &format, &buffer, Frames);
+}
+
+int main(void) {
+    atomic_store(&request, 1);
+    atomic_store(&enabled, true);
+    for (unsigned i = 0; i < Frames; ++i) instrumental[i] = (EeveeStereoFrame){0.25f, 0.3f};
+
+    play(0.5f);
+    assert(samples[0] == 0.5f);
+    EeveeInstrumentalStream stream = EeveeInstrumentalCurrentStream();
+    assert(stream.generation == 1 && stream.sampleRate == 48000);
+    assert(EeveeInstrumentalRead(1, incoming, Frames) == 0);
+    play(0.5f);
+    assert(samples[0] == 0 && EeveeInstrumentalDelayMs() == 8000);
+    assert(EeveeInstrumentalRead(1, incoming, Frames) == Frames);
+    assert(incoming[0].left == 0.5f && incoming[0].right == 0.5f);
+    assert(EeveeInstrumentalWrite(1, instrumental, Frames, 0) == Frames);
+
+    for (unsigned i = 1; i < 48000 * 8 / Frames; ++i) {
+        play(0.8f);
+        assert(samples[0] == 0);
+        assert(EeveeInstrumentalRead(1, incoming, Frames) == Frames);
+    }
+
+    EeveeInstrumentalSetPlaying(false);
+    play(0.7f);
+    assert(samples[0] == 0.7f);
+    EeveeInstrumentalSetPlaying(true);
+    play(0.9f);
+    assert(samples[(Frames - 1) * 2] == 0.25f);
+    assert(fabsf(samples[Frames * 2 - 1] - 0.3f) < 0.00001f);
+    assert(EeveeInstrumentalStatus() == 2);
+    play(0.9f);
+    assert(samples[0] == 0.8f && EeveeInstrumentalStatus() == 3);
+
+    EeveeInstrumentalReset();
+    assert(EeveeInstrumentalWrite(1, instrumental, Frames, 0) == 0);
+    play(0.6f);
+    assert(samples[0] == 0.6f && EeveeInstrumentalCurrentStream().generation == 2);
+    assert(EeveeInstrumentalRead(2, incoming, Frames) == 0);
+    play(0.6f);
+    assert(samples[0] == 0);
+    assert(EeveeInstrumentalRead(2, incoming, Frames) == Frames);
+    assert(incoming[0].left == 0.6f);
+
+    format.mSampleRate = 32000;
+    play(0.4f);
+    assert(samples[0] == 0.4f && EeveeInstrumentalStatus() == 4);
+    assert(EeveeInstrumentalDelayMs() == 0);
+
+    puts("PASS: aligned wet and dry playback, pause, seek reset and unsupported format");
+}
diff --git a/Tools/LiveInstrumental.md b/Tools/LiveInstrumental.md
new file mode 100644
index 0000000..66396e1
--- /dev/null
+++ b/Tools/LiveInstrumental.md
@@ -0,0 +1,7 @@
+# 即時去人聲 · UVR Inst HQ 4
+
+此功能需要 iOS 16 以上，以及包含新版 Pixie 音訊模組的 EeveeSpotify IPA。相容的 Spotify 建置版本由 Pixie 封裝流程決定，目前為 9.2.0 與 9.2.2。開啟 **EeveeSpotify 設定 → 即時去人聲 · UVR Inst HQ 4**，匯入 `InstHQ4.mlpackage`，再打開開關。使用 GitHub Actions 的 **Build IPA (PATCHED)** 時，可勾選 **uvr_hq4** 隨 IPA 內建模型，安裝後可直接開啟。
+
+在已安裝 Xcode 與 Python 3.12 的 Mac 上執行 `bash Tools/prepare-hq4-model.sh /path/to/output`。轉換程式會驗證 HQ 4 權重的 SHA-256、Core ML 輸入輸出格式，以及轉換後的輸出與 ONNX 模型的一致性。可將產生的 `InstHQ4.mlpackage` 傳至 iPhone 後從「檔案」匯入。也可在簽署 IPA 前將 `InstHQ4.mlmodelc` 放在 `Payload/Spotify.app/`，使 app 開啟時自動找到模型。模型轉換沿用 [Music-MelBand-iOS](https://github.com/anton86511/Music-MelBand-iOS/tree/15902924b33122a1f9ba9d3c9f622850666d529e) 的流程。
+
+HQ 4 以約 5.9 秒的視窗推論，播放保留約 8 秒緩衝。切歌或拖動進度會重新緩衝，切換前仍在緩衝區內的尾段會被清掉。關閉去人聲會回到播放器當前進度。推論錯過播放時限或裝置過熱時，會播出同一位置的緩衝原聲。Core ML 可使用 CPU 和 GPU，實際運算分配由 iOS 決定。支援此裝置上 44.1 kHz 或 48 kHz 的立體聲 PCM。
diff --git a/Tools/prepare-hq4-model.py b/Tools/prepare-hq4-model.py
new file mode 100644
index 0000000..12f6416
--- /dev/null
+++ b/Tools/prepare-hq4-model.py
@@ -0,0 +1,74 @@
+"""Convert a UVR MDX-Net ONNX model to the app's Core ML contract."""
+
+import argparse
+import platform
+from pathlib import Path
+
+import coremltools as ct
+import numpy as np
+import onnxruntime as ort
+import torch
+from onnx2torch import convert
+
+FLOAT16 = 65552
+
+
+def verify(output, reference, shape, minimum_snr):
+    if output.shape != shape or not np.isfinite(output).all():
+        raise ValueError("The converted model produced invalid output.")
+    snr = 20 * np.log10(np.linalg.norm(reference) / max(np.linalg.norm(output - reference), 1e-12))
+    if snr < minimum_snr:
+        raise ValueError(f"Conversion fidelity {snr:.1f} dB is below {minimum_snr} dB.")
+    print(f"Verified against ONNX: {snr:.1f} dB SNR", flush=True)
+
+
+def main(source: Path, destination: Path, bins: int):
+    shape = (1, 4, bins, 256)
+    torch.set_num_threads(2)
+    options = ort.SessionOptions()
+    options.intra_op_num_threads = 2
+    session = ort.InferenceSession(str(source), options, providers=["CPUExecutionProvider"])
+    audio_spectrum = np.random.default_rng(20).normal(0, 3, shape).astype(np.float32)
+    reference = session.run(["output"], {"input": audio_spectrum})[0]
+    if reference.shape != shape or not np.isfinite(reference).all():
+        raise ValueError("Unexpected ONNX model output.")
+    example = torch.from_numpy(audio_spectrum)
+    network = convert(str(source)).eval()
+    with torch.inference_mode():
+        verify(network(example).numpy(), reference, shape, 75)
+    with torch.no_grad():
+        traced = torch.jit.trace(network, example)
+    model = ct.convert(
+        traced,
+        inputs=[ct.TensorType(name="input", shape=shape, dtype=np.float16)],
+        outputs=[ct.TensorType(name="output", dtype=np.float16)],
+        convert_to="mlprogram",
+        compute_precision=ct.precision.FLOAT32,
+        compute_units=ct.ComputeUnit.CPU_AND_GPU,
+        minimum_deployment_target=ct.target.iOS16,
+        skip_model_load=True,
+    )
+    model.save(str(destination))
+    spec = ct.models.MLModel(str(destination), skip_model_load=True).get_spec()
+    inputs = spec.description.input
+    outputs = spec.description.output
+    if (spec.WhichOneof("Type") != "mlProgram" or len(inputs) != 1 or len(outputs) != 1
+            or inputs[0].name != "input" or outputs[0].name != "output"
+            or tuple(inputs[0].type.multiArrayType.shape) != shape
+            or tuple(outputs[0].type.multiArrayType.shape) != shape
+            or inputs[0].type.multiArrayType.dataType != FLOAT16
+            or outputs[0].type.multiArrayType.dataType != FLOAT16):
+        raise ValueError("Unexpected Core ML model signature.")
+    if platform.system() == "Darwin":
+        loaded = ct.models.MLModel(str(destination), compute_units=ct.ComputeUnit.CPU_ONLY)
+        verify(loaded.predict({"input": audio_spectrum.astype(np.float16)})["output"].astype(np.float32),
+               reference, shape, 40)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("source", type=Path)
+    parser.add_argument("destination", type=Path)
+    parser.add_argument("--bins", type=int, required=True)
+    args = parser.parse_args()
+    main(args.source, args.destination, args.bins)
diff --git a/Tools/prepare-hq4-model.sh b/Tools/prepare-hq4-model.sh
new file mode 100644
index 0000000..4ad01e9
--- /dev/null
+++ b/Tools/prepare-hq4-model.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ $# -ne 1 ]]; then
+  echo "Usage: bash Tools/prepare-hq4-model.sh OUTPUT_DIRECTORY" >&2
+  exit 2
+fi
+
+script_dir="$(cd "$(dirname "$0")" && pwd)"
+mkdir -p "$1"
+output="$(cd "$1" && pwd)"
+if [[ -e "$output/InstHQ4.mlpackage" || -e "$output/InstHQ4.mlmodelc" ]]; then
+  echo "Choose a directory without an existing InstHQ4 model." >&2
+  exit 2
+fi
+
+work="$(mktemp -d)"
+trap 'rm -rf "$work"' EXIT
+url="https://github.com/TRvlvr/model_repo/releases/download/all_public_uvr_models/UVR-MDX-NET-Inst_HQ_4.onnx"
+curl --fail --location --retry 3 --proto '=https' --proto-redir '=https' "$url" --output "$work/InstHQ4.onnx"
+printf '%s  %s\n' 3c4b5b9b05090fdf238f38ba5046813982d50e2a652e9cb3324ea79720c3c9c8 "$work/InstHQ4.onnx" | shasum -a 256 -c
+"${HQ4_PYTHON:-python3.12}" -m venv "$work/venv"
+python="$work/venv/bin/python"
+"$python" -m pip install 'torch==2.9.1' 'torchvision==0.24.1' 'coremltools==9.0' \
+  'onnx2torch==1.5.15' 'onnx==1.23.2' 'onnxruntime==1.24.2' 'numpy<2.3'
+"$python" "$script_dir/prepare-hq4-model.py" "$work/InstHQ4.onnx" "$work/InstHQ4.mlpackage" --bins 2560
+xcrun --sdk iphoneos coremlcompiler compile "$work/InstHQ4.mlpackage" "$work"
+test -d "$work/InstHQ4.mlmodelc"
+mv "$work/InstHQ4.mlpackage" "$work/InstHQ4.mlmodelc" "$output/"
