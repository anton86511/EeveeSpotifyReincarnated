+
+typedef struct {
+    float left;
+    float right;
+} EeveeStereoFrame;
+
+typedef struct {
+    uint32_t generation;
+    uint32_t sampleRate;
+} EeveeInstrumentalStream;
+
+bool EeveeInstrumentalAvailable(void);
+bool EeveeInstrumentalEnable(void);
+void EeveeInstrumentalDisable(void);
+void EeveeInstrumentalReset(void);
+void EeveeInstrumentalSetPlaying(bool playing);
+uint32_t EeveeInstrumentalDelayMs(void);
